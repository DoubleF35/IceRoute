# Dependency source. This is NOT the file that gets installed.
#
#   requirements.in   (this file: loose constraints, hand-written)
#        │
#        │  uv pip compile requirements.in -o requirements.txt
#        ▼
#   requirements.txt  (exact pins for the WHOLE tree, generated)
#
# Exact pins on purpose: a transitive upgrade must never change a measured
# number or break the offline demo behind our back. Always install from
# requirements.txt, never from this file.

# --- Deep learning -----------------------------------------------------------
# torch: Linux x86_64 wheel from PyPI, which bundles the CUDA 12.x runtime.
# Verified against driver 595.84 (CUDA 13.2) on an RTX 4050 Laptop, 6 GB.
# CI installs the CPU wheel of the same version instead (see .github/workflows/ci.yml).
torch==2.8.0
torchvision==0.23.0

# --- Scientific data ---------------------------------------------------------
numpy<2.0                 # pyresample and some scientific wheels still build against the numpy 1.x ABI
scipy
xarray
netCDF4
h5netcdf                  # fallback backend: some AI4Arctic scenes are HDF5 in disguise
scikit-image
scikit-learn              # confusion matrix, metrics, HV threshold baseline

# --- Geospatial --------------------------------------------------------------
pyproj                    # CRS transforms + Geod for the geodesic distance check
pyresample                # resampling onto the EPSG:3413 grid, nearest neighbour
shapely                   # route simplification, geometry
rasterio                  # GeoTIFF output of the RIO / mask rasters

# --- Inference and quantization ----------------------------------------------
onnx
onnxruntime               # CPU on purpose: INT8 is demonstrated without a GPU

# --- Demo --------------------------------------------------------------------
streamlit
pydeck                    # map; handles the polar projection better than folium
folium                    # fallback if pydeck misbehaves
matplotlib
pillow

# --- Config and utilities ----------------------------------------------------
pyyaml
tqdm
requests                  # dataset download from Figshare
psutil                    # peak RAM during inference

# --- Tests and quality -------------------------------------------------------
pytest
pytest-cov
ruff
